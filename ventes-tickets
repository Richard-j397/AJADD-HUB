<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>AJADD HUB — Tickets & Ventes</title>

<style>
*{
    box-sizing:border-box;
    margin:0;
    padding:0;
    font-family:Arial,sans-serif;
}

body{
    background:#f5f6fa;
    color:#222;
}

header{
    background:#111827;
    color:white;
    padding:20px;
}

header h1{
    font-size:24px;
}

header p{
    margin-top:5px;
    color:#d1d5db;
}

.container{
    max-width:1250px;
    margin:auto;
    padding:25px;
}

.stats{
    display:grid;
    grid-template-columns:repeat(4,1fr);
    gap:15px;
    margin-bottom:25px;
}

.card{
    background:white;
    padding:20px;
    border-radius:12px;
    box-shadow:0 3px 12px rgba(0,0,0,.08);
}

.card h3{
    color:#6b7280;
    font-size:14px;
    margin-bottom:8px;
}

.card strong{
    font-size:25px;
}

.actions{
    display:flex;
    gap:10px;
    flex-wrap:wrap;
    margin-bottom:20px;
}

button{
    border:none;
    padding:11px 16px;
    border-radius:8px;
    cursor:pointer;
    font-weight:bold;
}

.btn-primary{
    background:#111827;
    color:white;
}

.btn-success{
    background:#16a34a;
    color:white;
}

.btn-danger{
    background:#dc2626;
    color:white;
}

.btn-secondary{
    background:#e5e7eb;
    color:#111827;
}

.filters{
    display:flex;
    gap:10px;
    flex-wrap:wrap;
    margin-bottom:20px;
}

input,select{
    padding:12px;
    border:1px solid #d1d5db;
    border-radius:8px;
    background:white;
}

input{
    flex:1;
    min-width:220px;
}

.section{
    margin-top:30px;
    margin-bottom:30px;
}

.section h2{
    margin-bottom:15px;
}

.table-container{
    background:white;
    border-radius:12px;
    overflow:auto;
    box-shadow:0 3px 12px rgba(0,0,0,.08);
}

table{
    width:100%;
    border-collapse:collapse;
}

th,td{
    padding:14px;
    border-bottom:1px solid #eee;
    text-align:left;
}

th{
    background:#f9fafb;
}

.badge{
    padding:5px 9px;
    border-radius:20px;
    font-size:12px;
    font-weight:bold;
}

.badge-open{
    background:#dcfce7;
    color:#166534;
}

.badge-closed{
    background:#fee2e2;
    color:#991b1b;
}

.modal{
    display:none;
    position:fixed;
    inset:0;
    background:rgba(0,0,0,.55);
    justify-content:center;
    align-items:center;
    padding:20px;
}

.modal-content{
    background:white;
    width:100%;
    max-width:550px;
    padding:25px;
    border-radius:15px;
    max-height:90vh;
    overflow:auto;
}

.modal-content h2{
    margin-bottom:20px;
}

.form-group{
    margin-bottom:15px;
}

.form-group label{
    display:block;
    margin-bottom:6px;
    font-weight:bold;
}

.form-group input,
.form-group select{
    width:100%;
}

.modal-actions{
    display:flex;
    gap:10px;
    margin-top:20px;
}

.message{
    margin-bottom:15px;
    padding:12px;
    border-radius:8px;
    display:none;
}

.success{
    background:#dcfce7;
    color:#166534;
}

.error{
    background:#fee2e2;
    color:#991b1b;
}

@media(max-width:800px){
    .stats{
        grid-template-columns:repeat(2,1fr);
    }
}

@media(max-width:500px){
    .stats{
        grid-template-columns:1fr;
    }
}
</style>
</head>

<body>

<header>
    <h1>AJADD HUB — Tickets & Ventes</h1>
    <p>Gestion des billets, stocks, ventes et recettes</p>
</header>

<div class="container">

<div id="message" class="message"></div>

<!-- STATISTIQUES -->

<div class="stats">

    <div class="card">
        <h3>Types de tickets</h3>
        <strong id="totalTypes">0</strong>
    </div>

    <div class="card">
        <h3>Tickets disponibles</h3>
        <strong id="totalStock">0</strong>
    </div>

    <div class="card">
        <h3>Tickets vendus</h3>
        <strong id="totalVendus">0</strong>
    </div>

    <div class="card">
        <h3>Recettes</h3>
        <strong id="totalRecettes">0 FCFA</strong>
    </div>

</div>


<!-- GESTION TICKETS -->

<div class="section">

<h2>🎫 Gestion des tickets</h2>

<div class="actions">

<button class="btn-primary" onclick="ouvrirModalTicket()">
+ Nouveau ticket
</button>

<button class="btn-secondary" onclick="chargerTout()">
Actualiser
</button>

</div>

<div class="filters">

<input
type="text"
id="recherche"
placeholder="Rechercher..."
oninput="afficherTickets()"
>

<select id="filtreStatut" onchange="afficherTickets()">

<option value="">Tous les statuts</option>
<option value="ouvert">Ouvert</option>
<option value="ferme">Fermé</option>

</select>

</div>

<div class="table-container">

<table>

<thead>

<tr>
<th>Événement</th>
<th>Type</th>
<th>Prix</th>
<th>Stock</th>
<th>Vendus</th>
<th>Statut</th>
<th>Action</th>
</tr>

</thead>

<tbody id="ticketsTable"></tbody>

</table>

</div>

</div>


<!-- VENTE -->

<div class="section">

<h2>💰 Enregistrer une vente</h2>

<div class="card">

<div class="form-group">

<label>Acheteur</label>

<input
type="text"
id="acheteur"
placeholder="Nom de l'acheteur"
>

</div>


<div class="form-group">

<label>Téléphone</label>

<input
type="text"
id="telephone"
placeholder="+228..."
>

</div>


<div class="form-group">

<label>Ticket</label>

<select id="ticketVente" onchange="calculerTotal()">

<option value="">
Sélectionner un ticket
</option>

</select>

</div>


<div class="form-group">

<label>Quantité</label>

<input
type="number"
id="quantiteVente"
value="1"
min="1"
oninput="calculerTotal()"
>

</div>


<div class="form-group">

<label>Mode de paiement</label>

<select id="modePaiement">

<option value="Espèces">Espèces</option>
<option value="TMoney">TMoney</option>
<option value="Flooz">Flooz</option>
<option value="Carte bancaire">Carte bancaire</option>
<option value="Autre">Autre</option>

</select>

</div>


<div class="form-group">

<label>Total</label>

<input
type="text"
id="totalVente"
readonly
value="0 FCFA"
>

</div>


<button
class="btn-success"
onclick="enregistrerVente()"
>

Enregistrer la vente

</button>

</div>

</div>


<!-- HISTORIQUE -->

<div class="section">

<h2>📋 Historique des ventes</h2>

<div class="table-container">

<table>

<thead>

<tr>

<th>Acheteur</th>
<th>Téléphone</th>
<th>Ticket</th>
<th>Quantité</th>
<th>Total</th>
<th>Paiement</th>

</tr>

</thead>

<tbody id="ventesTable"></tbody>

</table>

</div>

</div>

</div>


<!-- MODAL TICKET -->

<div class="modal" id="ticketModal">

<div class="modal-content">

<h2 id="modalTitle">
Nouveau ticket
</h2>


<div class="form-group">

<label>Événement</label>

<input
type="text"
id="evenement"
>

</div>


<div class="form-group">

<label>Type</label>

<select id="type">

<option value="Standard">
Standard
</option>

<option value="Réservation">
Réservation
</option>

<option value="VIP">
VIP
</option>

</select>

</div>


<div class="form-group">

<label>Prix (FCFA)</label>

<input
type="number"
id="prix"
>

</div>


<div class="form-group">

<label>Quantité</label>

<input
type="number"
id="quantite"
>

</div>


<div class="form-group">

<label>Tickets déjà vendus</label>

<input
type="number"
id="vendus"
value="0"
>

</div>


<div class="form-group">

<label>Statut</label>

<select id="statut">

<option value="ouvert">
Ouvert
</option>

<option value="ferme">
Fermé
</option>

</select>

</div>


<div class="modal-actions">

<button
class="btn-success"
onclick="enregistrerTicket()"
>
Enregistrer
</button>

<button
class="btn-secondary"
onclick="fermerModal()"
>
Annuler
</button>

</div>

</div>

</div>


<script>

/* ==========================
   CONFIGURATION
========================== */

const PROJECT_ID =
"6ac62abb001c74bb8de5";

const DATABASE_ID =
"6ac62bca002f025e7f1b";


/* ID DE LA TABLE TICKETS */

const TICKETS_TABLE_ID =
"6ac709db0007c3c2f81b";


/* ID DE LA TABLE VENTES */

const VENTES_TABLE_ID =
"REMPLACE_PAR_ID_VENTES_TICKETS";


const TICKETS_URL =
"https://cloud.appwrite.io/v1/tablesdb/" +
DATABASE_ID +
"/tables/" +
TICKETS_TABLE_ID +
"/rows";


const VENTES_URL =
"https://cloud.appwrite.io/v1/tablesdb/" +
DATABASE_ID +
"/tables/" +
VENTES_TABLE_ID +
"/rows";


let tickets = [];

let ventes = [];

let ticketEnCours = null;


/* ==========================
   MESSAGE
========================== */

function message(texte,type){

const box =
document.getElementById("message");

box.textContent = texte;

box.className =
"message " + type;

box.style.display = "block";

setTimeout(()=>{

box.style.display = "none";

},4000);

}


/* ==========================
   CHARGER TICKETS
========================== */

async function chargerTickets(){

try{

const response =
await fetch(TICKETS_URL,{

method:"GET",

credentials:"include",

headers:{

"Accept":"application/json",

"X-Appwrite-Project":
PROJECT_ID

}

});


const result =
await response.json();


if(!response.ok){

throw new Error(
result.message ||
"Erreur tickets"
);

}


tickets =
result.rows || [];


afficherTickets();

remplirSelectTickets();

calculerStats();


}catch(error){

console.error(error);

message(
"Erreur tickets : " +
error.message,
"error"
);

}

}


/* ==========================
   CHARGER VENTES
========================== */

async function chargerVentes(){

try{

const response =
await fetch(VENTES_URL,{

method:"GET",

credentials:"include",

headers:{

"Accept":"application/json",

"X-Appwrite-Project":
PROJECT_ID

}

});


const result =
await response.json();


if(!response.ok){

throw new Error(
result.message ||
"Erreur ventes"
);

}


ventes =
result.rows || [];


afficherVentes();


}catch(error){

console.error(error);

message(
"Erreur ventes : " +
error.message,
"error"
);

}

}


/* ==========================
   CHARGER TOUT
========================== */

async function chargerTout(){

await chargerTickets();

await chargerVentes();

}


/* ==========================
   AFFICHER TICKETS
========================== */

function afficherTickets(){

const tbody =
document.getElementById(
"ticketsTable"
);

tbody.innerHTML = "";


const recherche =
document.getElementById(
"recherche"
).value.toLowerCase();


const filtre =
document.getElementById(
"filtreStatut"
).value;


const liste =
tickets.filter(ticket=>{

const evenement =
(ticket.evenement || "")
.toLowerCase();

const type =
(ticket.type || "")
.toLowerCase();

const statut =
ticket.statut || "";


return (

(
evenement.includes(recherche) ||
type.includes(recherche)
)

&&

(
!filtre ||
statut === filtre
)

);

});


if(!liste.length){

tbody.innerHTML = `

<tr>

<td colspan="7"
style="text-align:center;padding:30px">

Aucun ticket trouvé.

</td>

</tr>

`;

return;

}


liste.forEach(ticket=>{

const tr =
document.createElement("tr");


const quantite =
Number(ticket.quantite || 0);

const vendus =
Number(ticket.vendus || 0);


tr.innerHTML = `

<td>
${ticket.evenement || "-"}
</td>

<td>
${ticket.type || "-"}
</td>

<td>
${Number(ticket.prix || 0)
.toLocaleString("fr-FR")}
FCFA
</td>

<td>
${quantite}
</td>

<td>
${vendus}
</td>

<td>

<span class="badge ${
ticket.statut === "ouvert"
? "badge-open"
: "badge-closed"
}">

${ticket.statut || "-"}

</span>

</td>

<td>

<button
class="btn-secondary"
onclick="modifierTicket('${ticket.$id}')"
>
Modifier
</button>

<button
class="btn-danger"
onclick="supprimerTicket('${ticket.$id}')"
>
Supprimer
</button>

</td>

`;

tbody.appendChild(tr);

});

}


/* ==========================
   STATISTIQUES
========================== */

function calculerStats(){

let stock = 0;

let vendus = 0;

let recettes = 0;


tickets.forEach(ticket=>{

const q =
Number(ticket.quantite || 0);

const v =
Number(ticket.vendus || 0);

const p =
Number(ticket.prix || 0);


stock += q;

vendus += v;

});


ventes.forEach(vente=>{

recettes +=
Number(vente.total || 0);

});


document.getElementById(
"totalTypes"
).textContent =
tickets.length;


document.getElementById(
"totalStock"
).textContent =
stock;


document.getElementById(
"totalVendus"
).textContent =
vendus;


document.getElementById(
"totalRecettes"
).textContent =
recettes.toLocaleString("fr-FR")
+ " FCFA";

}


/* ==========================
   MODAL
========================== */

function ouvrirModalTicket(){

ticketEnCours = null;

document.getElementById(
"modalTitle"
).textContent =
"Nouveau ticket";


document.getElementById(
"evenement"
).value = "";


document.getElementById(
"type"
).value =
"Standard";


document.getElementById(
"prix"
).value = "";


document.getElementById(
"quantite"
).value = "";


document.getElementById(
"vendus"
).value =
"0";


document.getElementById(
"statut"
).value =
"ouvert";


document.getElementById(
"ticketModal"
).style.display =
"flex";

}


function fermerModal(){

document.getElementById(
"ticketModal"
).style.display =
"none";

}


/* ==========================
   ENREGISTRER TICKET
========================== */

async function enregistrerTicket(){

const evenement =
document.getElementById(
"evenement"
).value.trim();


const type =
document.getElementById(
"type"
).value;


const prix =
document.getElementById(
"prix"
).value;


const quantite =
document.getElementById(
"quantite"
).value;


const vendus =
document.getElementById(
"vendus"
).value || "0";


const statut =
document.getElementById(
"statut"
).value;


if(!evenement || !prix || !quantite){

message(
"Remplissez les champs obligatoires.",
"error"
);

return;

}


const data = {

evenement,

type,

prix:String(prix),

quantite:String(quantite),

vendus:String(vendus),

statut,

createurId:"admin"

};


try{

let response;


if(!ticketEnCours){

response =
await fetch(TICKETS_URL,{

method:"POST",

credentials:"include",

headers:{

"Content-Type":
"application/json",

"Accept":
"application/json",

"X-Appwrite-Project":
PROJECT_ID

},

body:JSON.stringify({

rowId:
"ticket-" +
Date.now(),

data

})

});

}else{

response =
await fetch(

TICKETS_URL +
"/" +
encodeURIComponent(
ticketEnCours
),

{

method:"PATCH",

credentials:"include",

headers:{

"Content-Type":
"application/json",

"Accept":
"application/json",

"X-Appwrite-Project":
PROJECT_ID

},

body:JSON.stringify({
data
})

}

);


}


const result =
await response.json();


if(!response.ok){

throw new Error(
result.message ||
"Erreur ticket"
);

}


fermerModal();

message(
ticketEnCours
? "Ticket modifié."
: "Ticket créé.",
"success"
);


await chargerTickets();

}catch(error){

console.error(error);

message(
error.message,
"error"
);

}

}


/* ==========================
   MODIFIER TICKET
========================== */

function modifierTicket(id){

const ticket =
tickets.find(
t=>t.$id === id
);

if(!ticket) return;


ticketEnCours = id;


document.getElementById(
"modalTitle"
).textContent =
"Modifier le ticket";


document.getElementById(
"evenement"
).value =
ticket.evenement || "";


document.getElementById(
"type"
).value =
ticket.type || "Standard";


document.getElementById(
"prix"
).value =
ticket.prix || "";


document.getElementById(
"quantite"
).value =
ticket.quantite || "";


document.getElementById(
"vendus"
).value =
ticket.vendus || "0";


document.getElementById(
"statut"
).value =
ticket.statut || "ouvert";


document.getElementById(
"ticketModal"
).style.display =
"flex";

}


/* ==========================
   SUPPRIMER TICKET
========================== */

async function supprimerTicket(id){

if(!confirm(
"Voulez-vous supprimer ce ticket ?"
)) return;


try{

const response =
await fetch(

TICKETS_URL +
"/" +
encodeURIComponent(id),

{

method:"DELETE",

credentials:"include",

headers:{

"Accept":
"application/json",

"X-Appwrite-Project":
PROJECT_ID

}

}

);


if(!response.ok){

const result =
await response.json();

throw new Error(
result.message ||
"Erreur suppression"
);

}


message(
"Ticket supprimé.",
"success"
);


await chargerTickets();


}catch(error){

message(
error.message,
"error"
);

}

}


/* ==========================
   SELECT TICKETS
========================== */

function remplirSelectTickets(){

const select =
document.getElementById(
"ticketVente"
);


select.innerHTML = `

<option value="">
Sélectionner un ticket
</option>

`;


tickets.forEach(ticket=>{

const quantite =
Number(ticket.quantite || 0);

const vendus =
Number(ticket.vendus || 0);

const disponible =
quantite - vendus;


if(
ticket.statut === "ouvert" &&
disponible > 0
){

const option =
document.createElement("option");


option.value =
ticket.$id;


option.textContent =
(ticket.type || "") +
" — " +
(ticket.evenement || "") +
" — " +
Number(ticket.prix || 0)
.toLocaleString("fr-FR") +
" FCFA — Stock : " +
disponible;


select.appendChild(option);

}

});

}


/* ==========================
   CALCUL TOTAL
========================== */

function calculerTotal(){

const id =
document.getElementById(
"ticketVente"
).value;


const quantite =
Number(
document.getElementById(
"quantiteVente"
).value || 0
);


const ticket =
tickets.find(
t=>t.$id === id
);


if(!ticket){

document.getElementById(
"totalVente"
).value =
"0 FCFA";

return;

}


const total =
Number(ticket.prix || 0) *
quantite;


document.getElementById(
"totalVente"
).value =
total.toLocaleString("fr-FR") +
" FCFA";

}


/* ==========================
   ENREGISTRER VENTE
========================== */

async function enregistrerVente(){

const acheteur =
document.getElementById(
"acheteur"
).value.trim();


const telephone =
document.getElementById(
"telephone"
).value.trim();


const ticketId =
document.getElementById(
"ticketVente"
).value;


const quantite =
Number(
document.getElementById(
"quantiteVente"
).value || 0
);


const modePaiement =
document.getElementById(
"modePaiement"
).value;


const ticket =
tickets.find(
t=>t.$id === ticketId
);


if(
!acheteur ||
!telephone ||
!ticket ||
quantite <= 0
){

message(
"Veuillez remplir correctement les informations de vente.",
"error"
);

return;

}


const stock =
Number(ticket.quantite || 0);

const dejaVendus =
Number(ticket.vendus || 0);

const disponible =
stock - dejaVendus;


if(quantite > disponible){

message(
"Stock insuffisant. Il reste seulement " +
disponible +
" ticket(s).",
"error"
);

return;

}


const prix =
Number(ticket.prix || 0);


const total =
prix * quantite;


/* ==========================
   1. ENREGISTRER LA VENTE
========================== */

const venteData = {

ticketId:ticket.$id,

acheteur,

telephone,

typeTicket:
ticket.type || "",

quantite:
String(quantite),

prixUnitaire:
String(prix),

total:
String(total),

modePaiement

};


try{

const venteResponse =
await fetch(VENTES_URL,{

method:"POST",

credentials:"include",

headers:{

"Content-Type":
"application/json",

"Accept":
"application/json",

"X-Appwrite-Project":
PROJECT_ID

},

body:JSON.stringify({

rowId:
"vente-ticket-" +
Date.now(),

data:venteData

})

});


const venteResult =
await venteResponse.json();


if(!venteResponse.ok){

throw new Error(
venteResult.message ||
"Impossible d'enregistrer la vente."
);

}


/* ==========================
   2. METTRE À JOUR LE STOCK
========================== */

const nouveauVendus =
dejaVendus + quantite;


const ticketResponse =
await fetch(

TICKETS_URL +
"/" +
encodeURIComponent(
ticket.$id
),

{

method:"PATCH",

credentials:"include",

headers:{

"Content-Type":
"application/json",

"Accept":
"application/json",

"X-Appwrite-Project":
PROJECT_ID

},

body:JSON.stringify({

data:{

evenement:
ticket.evenement,

type:
ticket.type,

prix:
ticket.prix,

quantite:
ticket.quantite,

vendus:
String(nouveauVendus),

statut:
nouveauVendus >= stock
? "ferme"
: ticket.statut,

